// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Player model: stores information about League of Legends players
model Player {
  id               String         @id @default(cuid())
  summonerName     String         @unique
  displayName      String
  puuid            String         @unique
  summonerId       String         @unique
  accountId        String         @unique
  profileIconId    Int
  summonerLevel    Int
  
  // Relations
  pdlSnapshots     PDLSnapshot[]
  duoAnalyses      DuoAnalysis[]
  
  // Metadata
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  @@index([summonerName])
  @@map("players")
}

// PDL (Performance Data Line) Snapshot: daily snapshot of player rank/LP
model PDLSnapshot {
  id               String         @id @default(cuid())
  
  // Relations
  playerId         String
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Rank Data
  rank             String         // DIAMOND, PLATINUM, GOLD, SILVER, BRONZE, IRON
  tier             Int            // 1-4 (I, II, III, IV)
  leaguePoints     Int            // 0-100
  wins             Int
  losses           Int
  
  // Calculated Stats
  winRate          Float          // wins / (wins + losses) * 100
  mainRole         String?        // TOP, JUNGLE, MID, ADC, SUPPORT
  mainChampion     String?        // Champion name
  
  // Metadata
  capturedAt       DateTime       @default(now())
  
  @@unique([playerId, capturedAt])
  @@index([playerId, capturedAt])
  @@index([capturedAt])
  @@map("pdl_snapshots")
}

// DuoAnalysis: AI-generated analysis for duo compatibility (Phase 3)
model DuoAnalysis {
  id                    String     @id @default(cuid())
  
  // Relations
  player1Id             String
  player1               Player     @relation(fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id             String
  
  // Analysis Data
  compatibilityScore    Float      // 1-10 score
  strengths             String     // AI-generated analysis
  weaknesses            String
  recommendations       String
  
  // Cache Management
  cachedUntil           DateTime   // When to refresh analysis
  
  // Metadata
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  
  @@unique([player1Id, player2Id])
  @@index([player1Id])
  @@map("duo_analyses")
}
